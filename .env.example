# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# Projeto Supabase "MBY-Gestao" — URL e chave PUBLICÁVEL (seguras no navegador;
# o acesso aos dados é protegido pela Row Level Security do banco).
NEXT_PUBLIC_SUPABASE_URL=https://eepinznppxessntniukf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dCVDuFcVEyf0PZCEjx2b0g_H6qNTv-I

# URL pública do app — só uma reserva: os links de e-mail (confirmação, convite)
# usam o endereço de onde a pessoa está acessando. Em produção:
# https://made-by-you-gestao.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPCIONAL — somente no servidor. Habilita "convidar por e-mail" na página Equipe.
# Nunca exponha esta chave no navegador nem faça commit dela.
# SUPABASE_SERVICE_ROLE_KEY=

# Notificações push (Web Push/VAPID). Gere o par com: npx web-push generate-vapid-keys
# A chave pública vai para o navegador; a privada e o segredo ficam só no servidor.
# O mesmo PUSH_WEBHOOK_SECRET deve estar no Vault do Supabase ("push_webhook_secret"),
# junto com a URL do app ("app_url") — veja supabase/migrations/*_notifications.sql.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PUSH_WEBHOOK_SECRET=
# VAPID_SUBJECT=https://made-by-you-gestao.vercel.app
